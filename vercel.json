{
  "rewrites": [
    { "source": "/home", "destination": "/index.html" },
    { "source": "/model", "destination": "/model.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
